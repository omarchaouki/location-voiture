# ─────────────────────────────────────────────────────────────────────────────
# Copier en `.env` et remplir. AUCUNE de ces valeurs ne doit entrer dans le dépôt.
# Tout ce qui est marqué SERVEUR ne doit jamais être exposé au navigateur.
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de données --------------------------------------------------------
# Dev : fichier SQLite. Prod (Phase 12) : chaîne Postgres/Supabase.
DATABASE_URL=file:./data/dev.db

# --- Application ------------------------------------------------------------
# Origine publique, utilisée pour les liens d'invitation et les webhooks.
APP_URL=http://localhost:5173
# fr | ar | en
DEFAULT_LOCALE=fr

# --- Accès ------------------------------------------------------------------
# SERVEUR. Secret de signature des sessions (Better Auth, Phase 2).
# Générer avec : node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=

# Inscription publique en libre-service. Désactivée par défaut : c'est moi qui crée
# les organisations depuis /admin et j'envoie une invitation (cahier des charges §1).
SELF_SERVE_SIGNUP=false

# --- Paiement (Phase 9) -----------------------------------------------------
# manual | stripe | local_ma. `manual` est le seul utilisable au Maroc aujourd'hui
# (Stripe n'y opère pas — docs/DECISIONS.md §3).
PAYMENT_PROVIDER=manual
# SERVEUR. Laisser vide tant qu'aucune entité éligible n'existe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# TVA marocaine, en points de base : 2000 = 20 %.
VAT_RATE_BP=2000

# --- Emails (Phase 4) -------------------------------------------------------
# console | resend
NOTIFIER=console
RESEND_API_KEY=
NOTIFY_FROM="Registre <no-reply@example.ma>"

# --- Fichiers ---------------------------------------------------------------
# local | supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- GPS (Phase 7) ----------------------------------------------------------
# mock | traccar
GPS_PROVIDER=mock
TRACCAR_URL=
TRACCAR_TOKEN=

# Fond de carte MapLibre. VIDE = plan vierge, et AUCUNE requête vers un tiers :
# les véhicules, les traces et les zones restent parfaitement lisibles.
# Choisir un fournisseur engage ses conditions d'usage et lui envoie l'adresse IP du
# client à chaque déplacement de la carte — c'est une décision de déploiement.
# Exemple de style ouvert, sans clé : https://tiles.openfreemap.org/styles/liberty
MAP_STYLE_URL=

# --- Démonstration (Phase 10) -----------------------------------------------
# Réinitialisation nocturne des organisations de démo, heure LOCALE Africa/Casablanca.
DEMO_RESET_HOUR_LOCAL=3

# --- Site vitrine (Phase 11) ------------------------------------------------
# Adresse avertie à chaque demande de démonstration. VIDE = aucun envoi : les
# demandes attendent dans /admin, ce qui reste un comportement correct.
LEADS_NOTIFY_EMAIL=
