# ─────────────────────────────────────────────────────────────────────────────
# Copier en `.env` et remplir. AUCUNE de ces valeurs ne doit entrer dans le dépôt.
# Tout ce qui est marqué SERVEUR ne doit jamais être exposé au navigateur.
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de données --------------------------------------------------------
# Postgres partout depuis le 28/08/2026 — il n'y a plus de SQLite, ni de valeur par
# défaut : une base absente ARRÊTE le processus au lieu de tomber en silence.
#
# DEUX chaînes, et ce n'est pas une redondance.
#
#   DATABASE_URL — le POOLER, port 6543, mode « transaction ». C'est ce que l'application
#     utilise en service. Supabase ferme les connexions directes bien avant qu'un serveur
#     SSR n'en ait fini avec elles ; le pooler les recycle. Le `?sslmode=require` n'est pas
#     décoratif : postgres-js le lit dans l'URL, et c'est là que le TLS se décide.
#
#   DIRECT_URL — la connexion DIRECTE, port 5432. Elle ne sert QU'aux migrations
#     (`pnpm db:migrate`, `drizzle-kit`). Une migration enchaîne ses ordres dans une seule
#     session ; un pooler qui rend la connexion entre deux ordres laisse la base à moitié
#     migrée, et on ne s'en aperçoit pas tout de suite.
#
# Où les trouver : Supabase → Project Settings → Database → Connection string.
# Le mot de passe est celui du projet, PAS la clé anon ni la service_role.
# En développement, avec `pnpm db:local` (aucun Docker, aucune installation) :
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres
#   DIRECT_URL=postgresql://postgres@127.0.0.1:5433/postgres
#   DATABASE_POOL_MAX=1
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:<mot-de-passe>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# Taille du pool. Dix suffit à un SSR ; le petit Lightsail n'a rien à faire de plus, et
# le pooler Supabase compte les connexions dans son quota.
#
# EN DÉVELOPPEMENT AVEC `pnpm db:local` : mettre 1. Le Postgres local est PGlite, qui ne
# sert qu'une connexion à la fois ; au-delà, la deuxième requête simultanée est coupée
# (`read ECONNRESET`), et le tableau de bord de /admin en lance huit d'un coup.
DATABASE_POOL_MAX=10

# --- Application ------------------------------------------------------------
# Origine publique, utilisée pour les liens d'invitation et les webhooks.
# En production : l'origine PUBLIQUE, telle que le navigateur la voit — http://<ip> tant
# qu'il n'y a pas de domaine, puis https://<domaine>. Une valeur fausse casse les liens
# d'invitation ET les cookies de session.
APP_URL=http://localhost:5173
# fr | ar | en | es
DEFAULT_LOCALE=fr

# --- Accès ------------------------------------------------------------------
# SERVEUR. Secret de signature des sessions (Better Auth, Phase 2).
# Générer avec : node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=

# TRAPPE D'EXPLOITATION, et non le chemin du produit. `true` leve entierement le
# controle de l'endpoint d'inscription de Better Auth.
#
# L'inscription libre du produit passe par /$lang/inscription (src/server/signup.ts),
# qui monte l'agence, son abonnement d'essai et son compte proprietaire d'un geste, et
# n'ouvre l'endpoint que pour l'adresse qu'il est en train de creer. Elle fonctionne
# avec ce drapeau a `false` — le laisser a `false` est le bon reglage.
SELF_SERVE_SIGNUP=false

# --- Paiement (Phase 9) -----------------------------------------------------
# manual | stripe | local_ma. `manual` est le seul utilisable au Maroc aujourd'hui
# (Stripe n'y opère pas — docs/DECISIONS.md §3).
PAYMENT_PROVIDER=manual
# SERVEUR. Laisser vide tant qu'aucune entité éligible n'existe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# TVA marocaine, en points de base : 2000 = 20 %.
VAT_RATE_BP=2000

# --- Emails (Phase 4) -------------------------------------------------------
# console | zoho
#   console : rien ne part, tout s'affiche dans la sortie standard. Défaut, et le seul
#             sûr sur une machine de développement.
#   zoho    : envoi réel via ZeptoMail, le service TRANSACTIONNEL de Zoho.
NOTIFIER=console

# SERVEUR. Jeton « Send Mail » d'un Mail Agent ZeptoMail.
#
# ATTENTION : c'est bien ZeptoMail, PAS Zoho Mail. Zoho Mail est une boîte aux lettres
# pour qu'un humain écrive à un humain ; ses limites d'envoi et sa réputation
# d'expéditeur ne sont pas prévues pour des messages déclenchés par le produit, et une
# alerte d'échéance qui part par là finit en indésirable.
#
# Où le trouver : console ZeptoMail → Mail Agents → (votre agent) → Setup Info →
# « Send Mail Token ». Le préfixe `Zoho-enczapikey` est ajouté par le code : coller ici
# le jeton SEUL.
ZOHO_ZEPTOMAIL_TOKEN=

# Centre de données du compte ZeptoMail : com | eu | in | au | jp | ca | sa
# Il n'est PAS interchangeable — une clé européenne présentée à `.com` est refusée.
# `eu` est le choix courant depuis le Maroc : le centre le plus proche, et celui qui
# évite un transfert hors d'Europe pour les adresses de clients européens.
ZOHO_REGION=eu

# Expéditeur. Le domaine doit être VÉRIFIÉ chez Zoho (SPF + DKIM), sinon l'API refuse
# le message. Forme « Nom <adresse> » ou adresse nue.
NOTIFY_FROM="Flotta <no-reply@example.ma>"

# --- Fichiers ---------------------------------------------------------------
# local | supabase
#
# ACTIVES depuis le 29/08/2026 : logo d'agence et vignette de vehicule passent par
# src/server/storage/. `local` ecrit dans STORAGE_LOCAL_DIR et se sauvegarde avec le
# volume ; `supabase` parle a l'API Storage par fetch, sur un seau PRIVE nomme `flotta`
# qu'il faut creer a la main une fois.
#
# STORAGE_PROVIDER=supabase sans URL ni cle NE retombe PAS en silence sur le disque
# local : le demarrage echoue. Une agence qui croirait ses fichiers partis chez
# l'hebergeur alors qu'ils dorment sur une machine remplacee au prochain deploiement,
# c'est la pire des issues.
#
# SUPABASE_SERVICE_ROLE_KEY est une cle d'ADMINISTRATION : elle contourne le RLS et
# donne acces a toutes les organisations. Le cloisonnement des fichiers est donc tenu
# de NOTRE cote (`keyBelongsTo`, verifie avant le premier octet servi). Elle ne sort
# jamais du serveur, et n'a rien a faire dans une variable prefixee VITE_.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- GPS (Phase 7) ----------------------------------------------------------
# mock | traccar
GPS_PROVIDER=mock
TRACCAR_URL=
TRACCAR_TOKEN=

# Fond de carte MapLibre. VIDE = plan vierge, et AUCUNE requête vers un tiers :
# les véhicules, les traces et les zones restent parfaitement lisibles.
# Choisir un fournisseur engage ses conditions d'usage et lui envoie l'adresse IP du
# client à chaque déplacement de la carte — c'est une décision de déploiement.
# Exemple de style ouvert, sans clé : https://tiles.openfreemap.org/styles/liberty
MAP_STYLE_URL=

# --- Tâches planifiées ------------------------------------------------------
# Balayage des alertes, ingestion GPS, périodes de facturation, remise à zéro des démos.
#
# Vide en développement = ACTIVÉ. En production il faut l'écrire, et sur UN SEUL
# processus : deux ordonnanceurs enverraient les mêmes notifications en double.
ENABLE_CRON=

# --- Démonstration (Phase 10) -----------------------------------------------
# Réinitialisation nocturne des organisations de démo, heure LOCALE Africa/Casablanca.
DEMO_RESET_HOUR_LOCAL=3

# --- Site vitrine (Phase 11) ------------------------------------------------
# Adresse avertie à chaque demande de démonstration. VIDE = aucun envoi : les
# demandes attendent dans /admin, ce qui reste un comportement correct.
LEADS_NOTIFY_EMAIL=
