{
  "name": "flotta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx --env-file-if-exists=.env scripts/admin-create.ts",
    "check:tokens": "tsx scripts/check-contrast.ts",
    "check:hardcoded": "tsx scripts/check-hardcoded.ts",
    "vendor:rtl": "tsx scripts/vendor-rtl-text.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/demo-reset.ts",
    "demo:fill": "tsx --env-file-if-exists=.env scripts/demo-fill.ts",
    "demo:purge": "tsx --env-file-if-exists=.env scripts/demo-purge.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@mapbox/mapbox-gl-rtl-text": "0.4.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.48",
    "better-auth": "1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "i18next": "26.4.0",
    "lucide-react": "^1.34.0",
    "maplibre-gl": "6.5.0",
    "node-cron": "4.6.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "srvx": "^0.12.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.11.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
